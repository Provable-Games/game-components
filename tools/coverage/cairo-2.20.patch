@@ -52,0 +64,52 @@ pub fn build(
+fn emits_bytecode(debug_info: &CairoProgramDebugInfo, idx: usize) -> bool {
+    let span = debug_info
+        .sierra_statement_info
+        .get(idx)
+        .expect("missing Sierra statement CASM debug information");
+    assert!(
+        span.start_offset <= span.end_offset,
+        "invalid CASM bytecode span"
+    );
+    span.start_offset < span.end_offset
+}
+
+#[cfg(test)]
+mod instruction_span_tests {
+    use super::*;
+    use cairo_lang_sierra_to_casm::compiler::{
+        ReturnStatementDebugInfo, SierraStatementDebugInfo, StatementKindDebugInfo,
+    };
+
+    fn debug_info(start: usize, end: usize) -> CairoProgramDebugInfo {
+        CairoProgramDebugInfo {
+            sierra_statement_info: vec![SierraStatementDebugInfo {
+                start_offset: start,
+                end_offset: end,
+                instruction_idx: 0,
+                additional_kind_info: StatementKindDebugInfo::Return(ReturnStatementDebugInfo {
+                    ref_values: vec![],
+                }),
+            }],
+        }
+    }
+
+    #[test]
+    fn excludes_only_zero_bytecode_spans() {
+        assert!(!emits_bytecode(&debug_info(7, 7), 0));
+        assert!(emits_bytecode(&debug_info(7, 8), 0));
+        assert!(emits_bytecode(&debug_info(7, 15), 0));
+    }
+
+    #[test]
+    #[should_panic(expected = "missing Sierra statement CASM debug information")]
+    fn missing_statement_fails_closed() {
+        emits_bytecode(&debug_info(7, 8), 1);
+    }
+
+    #[test]
+    #[should_panic(expected = "invalid CASM bytecode span")]
+    fn reversed_span_fails_closed() {
+        emits_bytecode(&debug_info(8, 7), 0);
+    }
+}
